<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"

    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="br.edu.ifrn.sc.info.MainActivity">
    <include
        android:id="@+id/include"
        layout="@layout/activity_teste2" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toque em Gravar"
        android:textSize="18sp"
        tools:layout_editor_absoluteX="146dp"
        tools:layout_editor_absoluteY="415dp"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="173dp"
        android:layout_height="46dp"
        android:text="🎙️ "
        android:visibility="invisible"
        app:icon="@drawable/btnouvir"
        tools:layout_editor_absoluteX="28dp"
        tools:layout_editor_absoluteY="458dp"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="165dp"
        android:layout_height="37dp"
        android:enabled="false"
        android:text="⏹️ Parar"
        tools:layout_editor_absoluteX="112dp"
        tools:layout_editor_absoluteY="524dp"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/btnList"
        android:layout_width="166dp"
        android:layout_height="41dp"
        android:enabled="true"
        android:text="Listar"
        tools:layout_editor_absoluteX="117dp"
        tools:layout_editor_absoluteY="567dp"
        tools:ignore="MissingConstraints" />

    <ProgressBar
        android:id="@+id/progressUpload"
        android:layout_marginTop="32dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:id="@+id/imgAtividade"
        android:layout_width="251dp"
        android:layout_height="257dp"
        android:layout_marginTop="156dp"
        android:layout_marginEnd="80dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnPlayAtividade"
        android:layout_width="169dp"
        android:layout_height="43dp"
        android:text="🔊 Ouvir áudio"
        android:visibility="invisible"
        tools:layout_editor_absoluteX="214dp"
        tools:layout_editor_absoluteY="458dp"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="400dp"
        android:layout_height="50dp"
        android:layout_marginBottom="4dp"

        android:background="#505FA6"
        app:itemIconTint="@android:color/white"
        app:itemTextColor="@android:color/white"
        app:labelVisibilityMode="unlabeled"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.454"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

    <ImageView
        android:id="@+id/imageView13"
        android:layout_width="43dp"
        android:layout_height="51dp"
        android:src="@drawable/microfone"
        app:layout_constraintEnd_toEndOf="@+id/btnStart"
        app:layout_constraintStart_toStartOf="@+id/btnStart"
        tools:layout_editor_absoluteY="456dp"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:id="@+id/imageView14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/btnouvir"
        app:layout_constraintEnd_toEndOf="@+id/btnPlayAtividade"
        app:layout_constraintStart_toStartOf="@+id/btnPlayAtividade"
        tools:layout_editor_absoluteY="456dp"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>

