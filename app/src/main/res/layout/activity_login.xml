<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3D457A"
    android:backgroundTint="#3D457A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">


    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="44dp"
        android:backgroundTint="#FFFFFF"
        android:fontFamily="@font/lilita_oone"
        android:hint="E-mail"
        android:inputType="textEmailAddress"
        android:textColorLink="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLogin" />

    <EditText
        android:id="@+id/etSenha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#FFFFFF"
        android:fontFamily="@font/lilita_oone"
        android:hint="Senha"
        android:inputType="textPassword"
        android:textColorLink="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etEmail" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/menu_background_rounded"
        android:backgroundTint="#CDCFD7"
        android:fontFamily="@font/lilita_oone"
        android:text="Entrar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRegistrar" />

    <Button
        android:id="@+id/btnRegistrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/menu_background_rounded"
        android:fontFamily="@font/lilita_oone"
        android:text="Registrar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etSenha" />

    <ImageView

        android:id="@+id/imageView11"
        android:layout_width="119dp"

        android:layout_height="85dp"
        android:contentDescription="@null"
        android:src="@drawable/logo"
        tools:layout_editor_absoluteX="114dp"
        tools:layout_editor_absoluteY="3dp" />

    <TextView
        android:id="@+id/tvLogin"

        android:layout_width="349dp"
        android:layout_height="185dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="136dp"
        android:background="#00F6F6F6"
        android:fontFamily="@font/lilita_oone"
        android:text="Olá, pequeno(a) explorador(a)!"
        android:textColor="#FFFFFF"
        android:textSize="26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>

