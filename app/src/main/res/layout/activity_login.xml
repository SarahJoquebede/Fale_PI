<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3D457A"
    android:backgroundTint="#3D457A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">


    <EditText
        android:id="@+id/etEmail"
        android:layout_width="344dp"
        android:layout_height="51dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="272dp"
        android:backgroundTint="#FFFFFF"
        android:fontFamily="@font/lilita_oone"
        android:hint="E-mail"
        android:inputType="textEmailAddress"
        android:textColorLink="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView11" />

    <EditText
        android:id="@+id/etSenha"
        android:layout_width="369dp"
        android:layout_height="58dp"
        android:layout_marginTop="416dp"
        android:backgroundTint="#FFFFFF"
        android:fontFamily="@font/lilita_oone"
        android:hint="Senha"
        android:inputType="textPassword"
        android:textColorLink="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/menu_rectangle"
        android:backgroundTint="#2044D3"
        android:fontFamily="@font/lilita_oone"
        android:text="Entrar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etSenha" />

    <Button
        android:id="@+id/btnRegistrar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="92dp"
        android:background="@drawable/menu_rectangle"
        android:fontFamily="@font/lilita_oone"
        android:text="Registrar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etSenha" />

    <ImageView

        android:id="@+id/imageView11"
        android:layout_width="119dp"

        android:layout_height="85dp"
        android:layout_marginStart="112dp"
        android:layout_marginBottom="51dp"
        android:contentDescription="@null"
        android:src="@drawable/logo"
        app:layout_constraintBottom_toTopOf="@+id/tvLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/tvLogin"

        android:layout_width="348dp"
        android:layout_height="102dp"
        android:layout_marginTop="136dp"
        android:background="#00F6F6F6"
        android:fontFamily="@font/lilita_oone"
        android:text="Olá, pequeno(a) explorador(a)!"
        android:textColor="#FFFFFF"
        android:textSize="26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>

