<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="200dp"
    android:layout_height="150dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <!-- Ícone representativo para a seção -->

        <!-- Título principal -->

        <!-- Número de feedbacks (o mais importante) -->

        <TextView
            android:id="@+id/tv_num_pacientes"
            android:layout_width="85dp"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/lilita_oone"
            android:text="Avaliações                                                                           realizadas"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.207" />

        <!-- Texto complementar -->

        <TextView
            android:id="@+id/tv_pacientes_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/lilita_oone"
            android:textAppearance="?attr/textAppearanceDisplaySmall"
            android:textColor="@color/material_dynamic_neutral20"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_num_pacientes"
            app:layout_constraintTop_toBottomOf="@id/tv_num_pacientes"
            app:layout_constraintVertical_bias="0.166"
            tools:text="0" />

        <TextView
            android:id="@+id/tv_feedback_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/lilita_oone"
            android:text="finalizados"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textSize="8sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_pacientes_count"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.175"
            app:layout_constraintStart_toEndOf="@id/tv_pacientes_count"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.926" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="53dp"
            android:layout_height="45dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.234"
            app:srcCompat="@drawable/ic_email_dialog" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
