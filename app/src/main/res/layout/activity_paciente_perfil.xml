<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:visibility="visible"
    tools:visibility="visible">


    <include
        android:id="@+id/include"
        layout="@layout/activity_teste2" />
    <include
        layout="@layout/botao_menu_paciente"
        />


    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="91dp"
        android:layout_height="84dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="148dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/perfil" />

    <TextView
        android:id="@+id/tvNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome:"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="107dp"
        tools:layout_editor_absoluteY="148dp" />

    <TextView
        android:id="@+id/tvIdade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Idade:"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="200dp"
        tools:layout_editor_absoluteY="148dp" />

    <TextView
        android:id="@+id/tvCPF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CPF:"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="107dp"
        tools:layout_editor_absoluteY="190dp" />

    <TextView
        android:id="@+id/tvDesvio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desvio(s):"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="200dp"
        tools:layout_editor_absoluteY="190dp" />

    <TextView
        android:id="@+id/tvTelResponsavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Telefone(Responsável):"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="200dp"
        tools:layout_editor_absoluteY="232dp" />

    <TextView
        android:id="@+id/tvFiliacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filiação:"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="107dp"
        tools:layout_editor_absoluteY="232dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="302dp"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="108dp"
        tools:layout_editor_absoluteY="169dp">

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvAtvPendente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atividades pendentes"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        tools:layout_editor_absoluteX="35dp"
        tools:layout_editor_absoluteY="315dp" />

    <TextView
        android:id="@+id/tvAtvEnviada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="388dp"
        android:text="Atividades enviadas"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="19dp"
        android:layout_height="18dp"
        app:srcCompat="@drawable/pontos"
        tools:layout_editor_absoluteX="349dp"
        tools:layout_editor_absoluteY="323dp" />

    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="19dp"
        android:layout_height="18dp"
        app:srcCompat="@drawable/pontos"
        tools:layout_editor_absoluteX="349dp"
        tools:layout_editor_absoluteY="391dp" />

    <Button
        android:id="@+id/botaoPontos"
        android:layout_width="43dp"
        android:layout_height="39dp"
        android:text="Button"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@+id/imageView6"
        app:layout_constraintStart_toStartOf="@+id/imageView6"
        tools:layout_editor_absoluteY="315dp" />

    <Button
        android:id="@+id/botaoPontos2"
        android:layout_width="43dp"
        android:layout_height="39dp"
        android:text="Button"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@+id/imageView6"
        app:layout_constraintStart_toStartOf="@+id/imageView6"
        tools:layout_editor_absoluteY="379dp" />

    <View
        android:id="@+id/divider"
        android:layout_width="409dp"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="365dp" />

    <View
        android:id="@+id/divider2"
        android:layout_width="409dp"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="294dp" />

    <View
        android:id="@+id/divider3"
        android:layout_width="409dp"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="436dp" />

    <androidx.constraintlayout.widget.Barrier
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left" />


</androidx.constraintlayout.widget.ConstraintLayout>