<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_navbar_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"

    android:background="@drawable/menu_background_rounded"

    android:gravity="center_vertical"
    android:orientation="horizontal"

    app:layout_constraintBottom_toBottomOf="parent"
    android:layout_marginBottom="0dp">

    <LinearLayout
        android:id="@+id/btn_nav_home_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="Início"
            android:src="@drawable/home_menu"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"/>

        <View
            android:id="@+id/indicator_home"
            android:layout_width="match_parent"
            android:layout_height="3dp"

            android:background="#3D457A"

            android:layout_gravity="bottom"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_nav_acesso_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_acesso"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="Blocos de Menu"
            android:src="@drawable/blocos_menu"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"/>

        <View
            android:id="@+id/indicator_acesso"
            android:layout_width="match_parent"
            android:layout_height="3dp"

            android:background="@android:color/transparent"

            android:layout_gravity="bottom"/>

    </LinearLayout>
</LinearLayout>