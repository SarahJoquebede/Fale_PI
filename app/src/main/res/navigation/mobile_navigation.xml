<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_profissional_main">

    <!-- Tela Principal do Fonoaudiólogo (Sua tela de Início) -->
    <fragment
        android:id="@+id/nav_profissional_main"
    android:name="br.edu.ifrn.sc.info.ProfissionalMainFragment"
    android:label="Início"
    tools:layout="@layout/fragment_profissional_main" /> >

    <!-- Tela de Atividades (Blocos) -->
    <activity
        android:id="@+id/nav_blocos_activity"
    android:name="br.edu.ifrn.sc.info.BlocosActivity"
    android:label="Atividades"
    tools:layout="@layout/activity_blocos" />

    <!-- Tela de Lista de Pacientes -->
    <activity
        android:id="@+id/nav_lista_pacientes"
    android:name="br.edu.ifrn.sc.info.ListaPacienteActivity"
    android:label="Pacientes"
    tools:layout="@layout/activity_listapacientes" />

</navigation>
